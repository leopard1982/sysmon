#!/bin/sh
# Izinkan user memanggil `smartctl` (hanya perintah baca SMART NVMe) tanpa password, supaya
# widget bisa menampilkan SMART. Opt-in.
#   sudo desktop-htop-smart-setup            -> untuk user yang menjalankan sudo
#   desktop-htop-smart-setup --user NAMA     -> sebagai root (dipakai tombol login root di widget)
#   sudo desktop-htop-smart-setup --remove   -> cabut izin
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

FILE=/etc/sudoers.d/desktop-htop-smart

[ "$(id -u)" -eq 0 ] || { echo "Jalankan dengan: sudo desktop-htop-smart-setup" >&2; exit 1; }

if [ "${1:-}" = "--remove" ]; then
    rm -f "$FILE"
    echo "Izin dihapus: $FILE"
    exit 0
fi

if [ "${1:-}" = "--user" ]; then
    USER_NAME="${2:-}"
else
    USER_NAME="${SUDO_USER:-}"
fi
case "$USER_NAME" in
    ""|root|*[!a-z0-9_-]*|[!a-z_]*) echo "Nama user tidak valid. Jalankan lewat sudo dari akun biasa, atau pakai --user NAMA." >&2; exit 1 ;;
esac
id -u "$USER_NAME" >/dev/null 2>&1 || { echo "User tidak ditemukan: $USER_NAME" >&2; exit 1; }

SMARTCTL=/usr/sbin/smartctl
[ -x "$SMARTCTL" ] || { echo "smartctl belum terpasang: sudo apt install smartmontools" >&2; exit 1; }

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT
printf '%s ALL=(root) NOPASSWD: %s -j -i -H -A /dev/nvme0\n' "$USER_NAME" "$SMARTCTL" > "$TMP"
visudo -cf "$TMP" >/dev/null
install -m 0440 -o root -g root "$TMP" "$FILE"
echo "OK: $USER_NAME boleh menjalankan '$SMARTCTL -j -i -H -A /dev/nvme0' tanpa password."
echo "Widget akan menampilkan SMART dalam maksimal 1 menit."
